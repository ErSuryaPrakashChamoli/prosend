APP_NAME=ProSend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Longer than the slowest job (campaign preparation, 600s) so a running job is never picked up twice.
DB_QUEUE_RETRY_AFTER=660

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ProSend
# Only verified sender identities can send when this is true (defaults to true in production).
PROSEND_REQUIRE_VERIFIED_SENDERS=false
PROSEND_QUEUE=default
PROSEND_COMPOSE_MAX_RECIPIENTS=50
PROSEND_ATTACHMENTS_DISK=local
PROSEND_ATTACHMENTS_MAX_FILES=5
PROSEND_ATTACHMENTS_MAX_FILE_SIZE_KB=5120
PROSEND_DEFAULT_SEND_RATE=60
PROSEND_MAX_SEND_RATE=600
PROSEND_LARGE_AUDIENCE_THRESHOLD=500
# Data retention (prosend:prune, daily at 02:30)
PROSEND_RETAIN_BODIES_DAYS=90
PROSEND_RETAIN_MESSAGES_MONTHS=13
PROSEND_RETAIN_API_LOGS_DAYS=30
PROSEND_RETAIN_API_USAGE_MONTHS=13
PROSEND_RETAIN_AUDIT_MONTHS=24
